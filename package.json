{
  "name": "cool-games-launcher",
  "productName": "Cool Games Launcher",
  "version": "0.2.6",
  "description": "Futuristic local-AI game launcher for Linux: discover games on websites you add, download, install and play.",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Cool Games Launcher contributors"
  },
  "homepage": "https://github.com/Elias966/cool-games-launcher",
  "private": true,
  "main": "out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "vendor": "node scripts/fetch-vendor.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build --config vite.config.ts",
    "build": "npm run build:main && npm run build:renderer",
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "electron scripts/render-icon.cjs",
    "notices": "node scripts/notices.mjs",
    "eval:classifier": "node scripts/eval-classifier.mjs",
    "dist": "npm run typecheck && npm test && npm run build && npm run notices && electron-builder --linux AppImage --x64 --publish never && npm run repack && npm run checksums",
    "checksums": "node scripts/checksums.mjs",
    "repack": "node scripts/repack-appimage.mjs"
  },
  "dependencies": {
    "hls.js": "1.6.13",
    "jsdom": "^30.1.2",
    "onnxruntime-node": "^1.30.0",
    "selenium-webdriver": "^4.51.0",
    "tar": "^7.5.22",
    "wasm-vips": "^0.0.19",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "3.1.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/selenium-webdriver": "^4.35.7",
    "@types/three": "^0.186.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "motion": "^12.43.0",
    "postprocessing": "6.39.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.2",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "zod": "^4.6.6"
  },
  "desktopName": "cool-games-launcher.desktop"
}
